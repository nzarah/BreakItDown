function parseChartData() {
  const raw = document.getElementById('chart-data-text').value.trim();
  if (!raw) return [];
  return raw.split('\n').map(line => {
    const parts = line.split(',');
    return { label: (parts[0] || '').trim(), value: parseFloat((parts[1] || '1').trim()) || 1 };
  }).filter(d => d.label);
}

function buildBarChart() {
  const data = parseChartData();
  if (!data.length) { alert('Enter at least one row.'); return ''; }
  const W = 480, H = 260, pad = 48, barGap = 12;
  const max = Math.max(...data.map(d => d.value));
  const barW = Math.max(20, Math.floor((W - pad * 2 - barGap * (data.length - 1)) / data.length));
  const colors = ['#7c3aed','#a78bfa','#6d28d9','#8b5cf6','#c4b5fd','#4c1d95'];
  let bars = '', labels = '', vals = '';
  data.forEach((d, i) => {
    const x = pad + i * (barW + barGap);
    const bh = Math.round(((H - pad * 2) * d.value) / max);
    const y = H - pad - bh;
    const col = colors[i % colors.length];
    bars   += `<rect x="${x}" y="${y}" width="${barW}" height="${bh}" rx="4" fill="${col}" opacity="0.9"/>`;
    vals   += `<text x="${x + barW/2}" y="${y - 5}" text-anchor="middle" fill="#e4e4e7" font-size="10">${d.value}</text>`;
    const lbl = d.label.length > 8 ? d.label.slice(0,7)+'…' : d.label;
    labels += `<text x="${x + barW/2}" y="${H - pad + 14}" text-anchor="middle" fill="#a1a1aa" font-size="10">${lbl}</text>`;
  });
  return '<svg class="inserted-chart" width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg" style="background:#1a1825;">'
    + '<line x1="'+pad+'" y1="'+(pad/2)+'" x2="'+pad+'" y2="'+(H-pad)+'" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>'
    + '<line x1="'+pad+'" y1="'+(H-pad)+'" x2="'+(W-pad/2)+'" y2="'+(H-pad)+'" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>'
    + bars + vals + labels
    + '</'+'svg>';
}

function buildPieChart() {
  const data = parseChartData();
  if (!data.length) { alert('Enter at least one row.'); return ''; }
  const total = data.reduce((s, d) => s + d.value, 0);
  const colors = ['#7c3aed','#a78bfa','#6d28d9','#8b5cf6','#c4b5fd','#4c1d95','#ddd6fe'];
  const cx = 140, cy = 130, r = 100, W = 420, H = 260;
  let slices = '', legend = '', angle = -Math.PI / 2;
  data.forEach((d, i) => {
    const sweep = (d.value / total) * 2 * Math.PI;
    const x1 = cx + r * Math.cos(angle), y1 = cy + r * Math.sin(angle);
    const x2 = cx + r * Math.cos(angle + sweep), y2 = cy + r * Math.sin(angle + sweep);
    const large = sweep > Math.PI ? 1 : 0;
    const col = colors[i % colors.length];
    slices += `<path d="M${cx},${cy} L${x1.toFixed(1)},${y1.toFixed(1)} A${r},${r} 0 ${large},1 ${x2.toFixed(1)},${y2.toFixed(1)} Z" fill="${col}" opacity="0.9" stroke="#13111C" stroke-width="1.5"/>`;
    const ly = 36 + i * 20;
    legend += `<rect x="290" y="${ly - 9}" width="12" height="12" rx="2" fill="${col}"/>`;
    const pct = Math.round((d.value / total) * 100);
    const lbl = d.label.length > 14 ? d.label.slice(0,13)+'…' : d.label;
    legend += `<text x="308" y="${ly}" fill="#d4d4d8" font-size="11">${lbl} (${pct}%)</text>`;
    angle += sweep;
  });
  return '<svg class="inserted-chart" width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg" style="background:#1a1825;">'
    + slices + legend
    + '</'+'svg>';
}

function buildMindMap() {
  const center = (document.getElementById('mm-center').value || 'Topic').trim();
  const branches = document.getElementById('mm-branches').value.trim().split('\n').map(s => s.trim()).filter(Boolean);
  if (!branches.length) { alert('Add at least one branch.'); return ''; }
  const W = 520, H = 300, cx = W/2, cy = H/2, r = 95, nodeR = 38;
  const colors = ['#7c3aed','#8b5cf6','#a78bfa','#6d28d9','#c4b5fd','#4c1d95'];
  let lines = '', nodes = '';
  branches.forEach((b, i) => {
    const angle = (2 * Math.PI * i / branches.length) - Math.PI / 2;
    const bx = cx + r * Math.cos(angle), by = cy + r * Math.sin(angle);
    const col = colors[i % colors.length];
    lines += `<line x1="${cx}" y1="${cy}" x2="${bx.toFixed(1)}" y2="${by.toFixed(1)}" stroke="${col}" stroke-width="2" opacity="0.6"/>`;
    nodes += `<ellipse cx="${bx.toFixed(1)}" cy="${by.toFixed(1)}" rx="${nodeR}" ry="18" fill="${col}" opacity="0.85"/>`;
    const lbl = b.length > 12 ? b.slice(0,11)+'…' : b;
    nodes += `<text x="${bx.toFixed(1)}" y="${(by+0.5).toFixed(1)}" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="10" font-weight="600">${lbl}</text>`;
  });
  var cLabel = center.length > 10 ? center.slice(0,9)+'...' : center;
  return '<svg class="inserted-chart" width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg" style="background:#1a1825;">'
    + lines
    + '<circle cx="'+cx+'" cy="'+cy+'" r="48" fill="#7c3aed"/>'
    + '<text x="'+cx+'" y="'+cy+'" text-anchor="middle" dominant-baseline="middle" fill="white" font-size="12" font-weight="700">'+cLabel+'</text>'
    + nodes
    + '</'+'svg>';
}

