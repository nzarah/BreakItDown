  if (notesText.includes('Echo is waiting') || notesText.length < 20) {
    alert("Wait! You need to generate some notes in the Smart Editor first.");
    showPage('pg-notes');
    return;
  }

  const container = document.getElementById('cards-container');
  const btn = document.getElementById('btn-gen-cards');
  
  // UI State: Loading
  btn.disabled = true;
  btn.innerHTML = "Echo is Studying...";
  container.innerHTML = '<div class="col-span-full text-center py-20 text-zinc-500">Echo is extracting core concepts...</div>';

  try {
    // Firebase/Linux standard fetch call
    const response = await fetch('/api/flashcards', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ notesContent: notesText })
    });

    if (!response.ok) throw new Error('Generation failed');

    const res = await response.json();
    const cards = res.flashcards;

    btn.disabled = false;
    btn.innerHTML = "✨ AI Generate from Notes";
    
    if (!cards || cards.length === 0) {
      container.innerHTML = '<div class="col-span-full text-center text-zinc-500">No cards could be generated.</div>';
      return;
    }

    // Modernized card rendering using your established styles
    container.innerHTML = cards.map(c => `
      <div class="action-card-landing group relative border-l-4 border-l-pink-500 cursor-pointer transition-all duration-300" 
           onclick="toggleCard(this)">
        <div class="card-content">
          <div class="text-[10px] font-bold text-pink-500 uppercase tracking-widest mb-2">Question</div>
          <div class="text-white font-bold mb-4 card-front">${c.front}</div>
          <div class="card-back hidden pt-4 border-t border-white/5">
            <div class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest mb-1">Answer</div>
            <div class="text-zinc-400 text-sm">${c.back}</div>
          </div>
        </div>
        <div class="text-[9px] text-zinc-600 mt-4 uppercase">Click to reveal answer</div>
      </div>
    `).join('');

  } catch (err) {
    btn.disabled = false;
    btn.innerHTML = "AI Generate";
    container.innerHTML = `<div class="col-span-full text-red-400 text-center p-4">Error: ${err.message}</div>`;
    console.error("Study Center Error:", err);
  }
}

