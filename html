async function generateNotes(type) {
    const inputId = type === 'text' ? 'note-input' : 'yt-url';
    const outputId = type === 'text' ? 'note-output' : 'yt-output';
    const loaderId = type === 'text' ? 'notes-loader' : 'yt-loader';
    const btnId = type === 'text' ? 'btn-gen-notes' : 'btn-gen-yt';
    
    const val = document.getElementById(inputId).value;
    if (!val.trim()) return;

    const loader = document.getElementById(loaderId);
    const output = document.getElementById(outputId);
    const btn = document.getElementById(btnId);
    
    // UI Feedback
    loader.classList.remove('hidden');
    btn.disabled = true;
    output.innerHTML = '<div class="text-zinc-500">Echo is analyzing your content...</div>';

    try {
        const endpoint = type === 'yt' ? '/api/video' : '/api/notes';
        const body     = type === 'yt' ? { url: val } : { text: val };
        const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });

        const res = await response.json();
        if (!response.ok) throw new Error(res.error || 'Network response was not ok');

        loader.classList.add('hidden');
        btn.disabled = false;
        output.innerHTML = formatAIResponse(res.notes);
