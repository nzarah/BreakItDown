function formatAIResponse(text) {
  if (!text) return "";
  
  // Clean up the text and handle markdown-style formatting
  let html = text
    .replace(/### (.*?)(?:\n|$)/g, '<h3 class="text-lg font-bold text-violet-400 mt-6 mb-2 tracking-tight">$1</h3>')
    .replace(/## (.*?)(?:\n|$)/g, '<h2 class="text-xl font-bold text-white mt-8 mb-4 border-b border-white/5 pb-2 tracking-tight">$1</h2>')
    .replace(/\*\*(.*?)\*\*/g, '<strong class="text-white font-bold">$1</strong>')
    .replace(/- (.*?)(?:\n|$)/g, '<div class="flex gap-3 mb-2 text-zinc-400"><span class="text-violet-500">•</span><span>$1</span></div>')
    .replace(/\n/g, '<br>');

  return `<div class="prose prose-invert max-w-none">${html}</div>`;
}

